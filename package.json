{
  "name": "@1amsheldon/mail-mcp",
  "version": "1.4.0",
  "description": "MCP server for AI-powered email access via IMAP and SMTP",
  "keywords": [
    "mcp",
    "email",
    "imap",
    "smtp",
    "ai",
    "llm",
    "model-context-protocol"
  ],
  "author": "1amSheldon",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/1amSheldon/mail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1amSheldon/mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/1amSheldon/mail-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "mail-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke:stdio": "node scripts/smoke-stdio.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "probe:mail-read": "node scripts/probe-mail-read.mjs",
    "smoke:import": "node -e \"import('./dist/index.js')\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cross-keychain": "^1.1.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "rate-limiter-flexible": "^10.0.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/smtp-server": "^3.5.13",
    "@types/turndown": "^5.0.6",
    "smtp-server": "^3.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
